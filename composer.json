{
    "name": "jacekkow/enable-banking-api",
    "description": "PSR-18 client for the Enable Banking API (Account Information Service)",
    "type": "library",
    "license": "BSD-3-Clause",
    "keywords": ["enable banking", "open banking", "psd2", "ais", "account information", "psr-18"],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^6.10 || ^7.0",
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/psr7": "^2.6",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "EnableBanking\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EnableBanking\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
